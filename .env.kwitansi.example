# =========================================================
# TEMPLATE .env — PERJALANAN DINAS (KWITANSI PERDIN)
# =========================================================
#
# Salin baris yang perlu ke .env (di folder yang sama dengan index.js),
# isi nilainya, lalu: pm2 restart bot-siska
#
# Semua variabel di sini OPSIONAL. Baris yang dibiarkan kosong atau
# tidak disalin memakai nilai bawaan yang tertulis di komentarnya.
# NIP ditulis tanpa spasi; daftar (beberapa orang) dipisah koma.

# ---------------------------------------------------------
# Login
# ---------------------------------------------------------

# Kunci rahasia penanda token login (12 jam). Isi teks acak panjang,
# mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kosong = diturunkan dari DATABASE_URL. Mengganti nilai ini membuat
# semua orang yang sedang login harus masuk ulang.
KWITANSI_RAHASIA=

# Admin: melihat & mengelola perjalanan dinas SEMUA bidang.
# NIP atau nomor WA (62...), dipisah koma. Kosong = tidak ada admin.
KWITANSI_ADMIN=

# Bendahara: memantau semua bidang (daftar, statistik, PDF) tanpa bisa
# mengubah. Bawaan: 199611272018121001. Kalau diisi, NIP bawaan itu
# ikut ditulis lagi bila masih bendahara.
KWITANSI_BENDAHARA=199611272018121001

# ---------------------------------------------------------
# Penandatangan di PDF
# ---------------------------------------------------------

# Pejabat Pembuat Komitmen (kwitansi, rincian, SPD, nominatif, SPBY,
# surat pembebanan biaya pembatalan).
# Bawaan: Alpha Sandro Adithyaswara, S.Sos., M.M. / 198703232015031002
KWITANSI_PPK_NAMA=
KWITANSI_PPK_NIP=

# Bendahara Pengeluaran (kwitansi, rincian, nominatif, SPBY).
# Bawaan: Prasetyo Muhammad Sidqi / 199611272018121001
KWITANSI_BENDAHARA_NAMA=
KWITANSI_BENDAHARA_NIP=

# Kepala Biro Keuangan dan BMN (Surat Pernyataan Pembatalan Tugas).
# Kosong = diambil otomatis dari Master Data (jabatan "Kepala Biro
# Keuangan ..."). Isi kalau pejabatnya berbeda / sedang Plt.
KWITANSI_KABIRO_NAMA=
KWITANSI_KABIRO_NIP=

# ---------------------------------------------------------
# Surat pembatalan
# ---------------------------------------------------------

# Nomor DIPA bawaan di Surat Pernyataan Pembebanan Biaya Pembatalan
# (masih bisa diubah di form pembatalan), mis.
#   SP DIPA-026.01.1.450938/2026 tanggal 2 Desember 2025
KWITANSI_DIPA=
